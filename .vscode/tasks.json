{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Hotel ML: tests",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-v"
      ],
      "options": {
        "env": {
          "PYTHONPATH": "${workspaceFolder}/src"
        }
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Hotel ML: doctor",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m",
        "hotel_ml",
        "doctor"
      ],
      "options": {
        "env": {
          "PYTHONPATH": "${workspaceFolder}/src"
        }
      },
      "problemMatcher": []
    }
  ]
}
